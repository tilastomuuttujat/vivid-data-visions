DATABASE[en]="Luke/Tilastot";
SOURCE[en]="Luonnonvarakeskus, Metsävarat";
VALUENOTE[en]("inventory","NFI 1 (1921-1924)")="Inventory results are calculated in accordance with present borders of Finland.";
VALUENOTE[en]("inventory","NFI 11 (2009-2013)")="According to NFI 11, growing stock volumes on forest land amounted to 2 295 million m³ and on poorly productive forest land 62 million m³.";
VALUENOTE[en]("inventory","NFI 12 (2014-2018)")="According to the NFI 12, growing stock volumes on forest land amounted to 2 409 million m³ and on poorly productive forest land 67 million m³.#";
VALUENOTE[en]("inventory","NFI 13 (2019-2023)")="The region of Åland measured in 2023. Municipalities of Inari, Utsjoki and Enontekiö were measured in 2022.#According to the NFI13 years 2019-2023, growing stock volumes on forest land amounted to 2 482 million m³ and on poorly productive forest land 70 "
"million m³.";
VALUENOTE[en]("inventory","NFI 13/14 (2020-2024)")="- The data for Southern Finland, Northern Finland, whole country, and by region are based on VMI13/14 (2020-2024) measurements.#- The region of Åland measured in 2023 and Upper Lapland in 2022.#";
VALUENOTE[en]("tree species","Pine (mill. m³)")="Pine includes all other coniferous species except Norway spruce.#The volume of other coniferous species in NFI12 is 3.3 million m³.#The volume of other coniferous species in NFI13 (2019-2023) is 3.5 million m³.";
CELLNOTE[en]("NFI 12 (2014-2018)","Lapland","*")=
"No NFI12 measurements in Enontekiö, Inari and Utsjoki region. Results are based on NFI11.";
