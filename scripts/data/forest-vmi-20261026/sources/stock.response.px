VALUENOTE[sv]("inventering","RST 1 (1921-1924)")="Inventeringsresultat är räknade på basis av Finlands nuvarande gränser.";
VALUENOTE[sv]("inventering","RST 11 (2009-2013)")="Enligt RST 11 var trädbeståndets volym på skogsmark 2 295 milj. m³ och på tvinmark  62 milj. m³.";
VALUENOTE[sv]("inventering","RST 12 (2014-2018)")="Enligt RST 12 var trädbeståndets volym på skogsmark 2 409 mn m³ och på tvinmark 67 mn m³.";
VALUENOTE[sv]("inventering","RST 13 (2019-2023)")="Mätningarna utfördes på Åland under 2023 och inom kommunerna Enare, Utsjoki och Enontekis under 2022.#Enligt RST13 år 2019-2023 var trädbeståndets volym på skogsmark 2 482 mn m³ och på tvinmark 70 mn m³.";
VALUENOTE[sv]("inventering","RST 13/14 (2020-2024)")="- Uppgifterna för Södra Finland, Norra Finland och hela landet samt landskapsvisa uppgifter baseras på mätningarna VMI13/14 (2020-2024).#- Mätningarna utfördes på Åland under 2023 och Övre Lappland under 2022.#";
VALUENOTE[sv]("trädslag","Tall (mn m³)")="Tall innehåller alla andra bärrträdslag utom gran.#Enligt RST12 resultat, är volymen andra barrträdslag totalt 3,3 miljoner kubikmeter.#Enligt RST13 (2019-2023) resultat, är volymen andra barrträdslag totalt 3,5 miljoner kubikmeter.";
CELLNOTE[sv]("RST 12 (2014-2018)","Lappland","*")=
"RST12:s mätningar gjordes inte i området Enontekis, Enare och Utsjoki. Resultaten för området baserar sig på RST11.";
SUBJECT-AREA[en]="Agriculture, Forestry and Fishery";
DESCRIPTION[en]="Growing stock volume on forest land and poorly productive forest land by tree species (mill. m³, %)";
TITLE[en]="Growing stock volume on forest land and poorly productive forest land by tree species by inventory, region and tree species";
CONTENTS[en]="Growing stock volume on forest land and poorly productive forest land by tree species";
STUB[en]="inventory","region";
HEADING[en]="tree species";
VARIABLECODE[en]("inventory")="inventointi";
VALUES[en]("inventory")="NFI 1 (1921-1924)","NFI 2 (1936-1938)","NFI 3 (1951-1953)","NFI 5 (1964-1970)","NFI 6 (1971-1976)","NFI 7 (1977-1984)","NFI 8 (1986-1994)","NFI 9 (1996-2003)","NFI 10 (2004-2008)","NFI 11 (2009-2013)","NFI 12 (2014-2018)","NFI 13 (2019-2023)",
"NFI 13/14 (2020-2024)";
VARIABLECODE[en]("region")="maakunta";
VALUES[en]("region")="WHOLE COUNTRY","SOUTHERN FINLAND","NORTHERN FINLAND","Uusimaa","Varsnais-Suomi","Satakunta","Kanta-Häme","Pirkanmaa","Päijät-Häme","Kymenlaakso","South Karelia","Etelä-Savo","Pohjois-Savo","North Karelia","Central Finland","South Ostrobothnia",
"Ostrobothnia","Central Ostrobothnia","North Ostrobothnia","Kainuu","Lapland","Åland";
VARIABLECODE[en]("tree species")="puulaji";
VALUES[en]("tree species")="Pine (mill. m³)","Spruce (mil. m³)","Birch (mill. m³)","Other broadleaved (mill. m³)","Total volume (mill. m³)","Growing stock on land available for wood production (%)";
TIMEVAL[en]("inventory")=TLIST(A1),"2025","2026","2027","2028","2029","2030","2031","2032","2033","2034","2035","2036","2037";
CODES[en]("region")="1","1.1","1.2","1.1.1","1.1.2","1.1.3","1.1.4","1.1.5","1.1.6","1.1.7","1.1.8","1.1.9","1.1.10","1.1.11","1.1.12","1.1.13","1.1.14","1.1.15","1.2.17","1.2.18","1.2.19","1.1.21";
CODES[en]("tree species")="Mänty","Kuusi","Koivu","Muut lehtipuut","Koko puusto","Puustosta puuntuotannon maalla";
MAP[en]("region")="maakunta-mvarat";
PRECISION[en]("tree species","Growing stock on land available for wood production (%)")=1;
LAST-UPDATED[en]="20251113 08:00";
UNITS[en]="mill. m³, %";
