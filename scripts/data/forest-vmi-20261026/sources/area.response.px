VARIABLECODE("maaluokka")="maaluokka";
VALUES("maaluokka")="Metsätalousmaa - Metsämaa","Metsätalousmaa - Kitumaa","Metsätalousmaa - Joutomaa","Metsätalousmaa - Metsätiet, varastot ym.","Metsätalousmaa - Yhteensä","Muu maa","Maapinta-ala";
