SOURCE[sv]="Luonnonvarakeskus, Metsävarat";
NOTE[sv]="Med tillväxten menas genonsnittlig årlig tillväxt från femårsperioden före inventering.";
NOTE[sv]("inventering")="RST 1 och 2.1: Inventeringsresultat är räknade på basis av Finlands gränser före landavträdelsen år 1944. RST 1-3: björk och andra lövträd visas tillsammans.";
VALUENOTE[sv]("inventering","RST 11 (2009-2013)")="Efter RST 11 var årlig tillväxt på skogsmark 102,7 milj. m³ och på tvinmark 1,7 milj. m³";
VALUENOTE[sv]("inventering","RST 12 (2014-2018)")="Efter RST 12 var årlig tillväxt på skogsmark 106,1 milj. m³ och på tvinmark 1,7 milj. m³";
VALUENOTE[sv]("inventering","RST 13 (2019-2023)")="Mätningarna utfördes på Åland under 2023 och inom kommunerna Enare, Utsjoki och Enontekis under 2022.#Efter RST13 (2019-2023) var årlig tillväxt på skogsmark 101,5 milj. m³ och på tvinmark 1,5 milj. m³";
VALUENOTE[sv]("inventering","RST 13/14 (2020-2024)")="- Uppgifterna för Södra Finland, Norra Finland och hela landet samt landskapsvisa uppgifter baseras på mätningarna VMI13/14 (2020-2024).#- Mätningarna utfördes på Åland under 2023 och Övre Lappland under 2022.##- Efter RST 13/14 (2020-2024) var årlig til"
"lväxt på skogsmark 101,7 milj. m³ och på tvinmark 1,5 milj. m³";
VALUENOTE[sv]("trädslag","Tall, mn m³/år")="Tall innehåller alla andra bärrträdslag utom gran.";
CELLNOTE[sv]("RST 12 (2014-2018)","Lappland","*")=
"RST12:s mätningar gjordes inte i området Enontekis, Enare och Utsjoki. Resultaten för området baserar sig på RST11.";
SUBJECT-AREA[en]="Agriculture, Forestry and Fishery";
DESCRIPTION[en]="Annual increment of growing stock on forest land and on poorly productive forest land (mill. m³/year, m³/ha/year)";
TITLE[en]="Annual increment of growing stock on forest land and on poorly productive forest land by inventory, region and tree species";
CONTENTS[en]="Annual increment of growing stock on forest land and on poorly productive forest land";
STUB[en]="inventory","region";
HEADING[en]="tree species";
VARIABLECODE[en]("inventory")="inventointi";
VALUES[en]("inventory")="NFI 1 (1921-1924)","NFI 2.1 (1936-1938)","NFI 2.2 (1936-1938)","NFI 3 (1951-1953)","NFI 5 (1964-1970)","NFI 6 (1971-1976)","NFI 7 (1977-1984)","NFI 8 (1986-1994)","NFI 9 (1996-2003)","NFI 10 (2004-2008)","NFI 11 (2009-2013)","NFI 12 (2014-2018)",
"NFI 13 (2019-2023)","NFI 13/14 (2020-2024)";
VARIABLECODE[en]("region")="maakunta";
VALUES[en]("region")="WHOLE COUNTRY","SOUTHERN FINLAND","NORTHERN FINLAND","Uusimaa","Varsnais-Suomi","Satakunta","Kanta-Häme","Pirkanmaa","Päijät-Häme","Kymenlaakso","South Karelia","Etelä-Savo","Pohjois-Savo","North Karelia","Central Finland","South Ostrobothnia",
"Ostrobothnia","Central Ostrobothnia","North Ostrobothnia","Kainuu","Lapland","Åland";
VARIABLECODE[en]("tree species")="puulaji";
VALUES[en]("tree species")="Pine, mill. m³/year","Spruce, mill. m³/year","Birch, mill. m³/year","Other broadleaved, mill. m³/year","Total, mill. m³/year","Mean annual increment, m³/ha/year";
TIMEVAL[en]("inventory")=TLIST(A1),"2025","2026","2027","2028","2029","2030","2031","2032","2033","2034","2035","2036","2037","2038";
CODES[en]("region")="1","1.1","1.2","1.1.1","1.1.2","1.1.3","1.1.4","1.1.5","1.1.6","1.1.7","1.1.8","1.1.9","1.1.10","1.1.11","1.1.12","1.1.13","1.1.14","1.1.15","1.2.17","1.2.18","1.2.19","1.1.21";
CODES[en]("tree species")="Mänty","Kuusi","Koivu","Muut lehtipuut","Koko puusto","Keskikasvu";
PRECISION[en]("tree species","Pine, mill. m³/year")=2;
PRECISION[en]("tree species","Spruce, mill. m³/year")=2;
PRECISION[en]("tree species","Birch, mill. m³/year")=2;
PRECISION[en]("tree species","Other broadleaved, mill. m³/year")=2;
PRECISION[en]("tree species","Total, mill. m³/year")=2;
LAST-UPDATED[en]="20251113 08:00";
UNITS[en]="m³, ha, year";
CONTACT[en]="tietopalvelu@luke.fi#<A HREF=https://www.luke.fi/en/statistics/forest-resources/ TARGET=_blank>Home page of the statistics</A>";
DATABASE[en]="Luke/Tilastot";
SOURCE[en]="Luonnonvarakeskus, Metsävarat";
NOTE[en]="Increment is the average annual increment during the last five growing periods preceding the inventory moment.";
NOTE[en]("inventory")="NFI 1 and 2.1: Inventory results calculated in accordance with borders of Finland before year 1944. NFI 1-3: birch and other broadleaved combined.";
VALUENOTE[en]("inventory","NFI 11 (2009-2013)")="According to the NFI 11, the increment on forest land amounted to 102.7 million m³ and 1.7 million m³ on poorly productive forest land.";
VALUENOTE[en]("inventory","NFI 12 (2014-2018)")="According to the NFI 12, the increment on forest land amounted to 106,1 million m³ and 1,7 million m³ on poorly productive forest land.";
VALUENOTE[en]("inventory","NFI 13 (2019-2023)")="The region of Åland measured in 2023. Municipalities of Inari, Utsjoki and Enontekiö were measured in 2022.#According to the NFI13 (2019-2023), the increment on forest land amounted to 101,5 million m³ and 1.5 million m³ on poorly productive forest land.";
VALUENOTE[en]("inventory","NFI 13/14 (2020-2024)")="- The data for Southern Finland, Northern Finland, whole country, and by region are based on VMI13/14 (2020-2024) measurements.#- The region of Åland measured in 2023 and Upper Lapland in 2022.##- According to the NFI 13/14 (2020-2024), the increment on "
"forest land amounted to 101,7 million m³ and 1.5 million m³ on poorly productive forest land.#";
VALUENOTE[en]("tree species","Pine, mill. m³/year")="Pine includes all other conifers except Norway spruce.";
CELLNOTE[en]("NFI 12 (2014-2018)","Lapland","*")=
"No NFI12 measurements in Enontekiö, Inari and Utsjoki region. Results are based on NFI11.";
